# API Keys — copy this file to .env and fill in real values
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
GROQ_API_KEY=your-groq-api-key-here
TAVILY_API_KEY=your-tavily-api-key-here

# Logging
LOG_LEVEL=INFO

# Research parameters
MAX_SUBQUESTIONS=5
MAX_SOURCES_PER_QUERY=20
DEFAULT_BUDGET_USD=0.50

# Models
PLANNER_MODEL=claude-3-5-sonnet-latest
SYNTHESIZER_MODEL=claude-3-5-sonnet-latest
CRITIC_MODEL=claude-3-5-sonnet-latest
